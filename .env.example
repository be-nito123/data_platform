# =========================================================
# DataVault — environment variables
# =========================================================
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored; never commit real credentials.
# =========================================================


# ---------------------------------------------------------
# Public site URL
# ---------------------------------------------------------
# Origin used for canonical URLs, Open Graph tags, robots.txt
# and the sitemap. No trailing slash.
# Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ---------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------
# Project settings -> API. The publishable/anon key is safe to
# expose to the browser because row level security is enforced
# in the database.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"


# ---------------------------------------------------------
# Google Sheets (required — powers all market data)
# ---------------------------------------------------------
# Google Cloud service account with the Sheets API enabled.
# Share both spreadsheets with GOOGLE_CLIENT_EMAIL as a Viewer.
GOOGLE_CLIENT_EMAIL="datavault-reader@your-project.iam.gserviceaccount.com"

# Paste the whole `private_key` value from the service account
# JSON file, keeping the surrounding quotes. It must begin with
# -----BEGIN PRIVATE KEY----- (not BEGIN RSA PRIVATE KEY).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Spreadsheet ID: the long id in the Docs URL
# https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID="your-primary-spreadsheet-id"
COT_GOOGLE_SHEET_ID="your-cot-spreadsheet-id"


# ---------------------------------------------------------
# Optional
# ---------------------------------------------------------
# Seconds that Google Sheets responses are cached in memory.
# Defaults to 300 (5 minutes). Set to 0 to always re-fetch,
# which is useful while editing the source sheet locally.
# SHEET_CACHE_TTL_SECONDS="300"
